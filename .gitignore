# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw source media (kept outside the repo — see ~/Desktop/Midline-source-media)
public/assets/images/T7-MID*
public/assets/images/T7-MIDA*
public/assets/images/T7-MIDB*

# Payload SQLite database (never web-served, never committed)
/data

# Payload local upload staging (superseded by R2 once configured)
/media

# Payload video uploads (local disk fallback; R2 in production)
/videos

# macOS
.DS_Store
