{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run migrate:build && npm run build",
  "regions": [
    "fra1"
  ],
  "functions": {
    "src/app/(payload)/**": {
      "maxDuration": 60
    },
    "src/app/api/**": {
      "maxDuration": 30
    }
  }
}
