# ═══════════════════════════════════════════════════════════════════════════
# Midline Aviation — environment variables
#
# Copy to .env for local development. On cPanel these go in the "Setup Node.js
# App" screen under Environment Variables, NOT in a .env file — Passenger
# injects them into the process, and a .env on the server is one more secret
# sitting inside the web root.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# readable by anyone. Never put a secret behind that prefix.
# ═══════════════════════════════════════════════════════════════════════════


# ── Site address ─────────────────────────────────────────── REQUIRED in prod
# Canonical origin, no trailing slash. Feeds canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt and JSON-LD. Falls back to https://midline-aviation.com
# when unset, so a wrong value here silently publishes wrong URLs to Google.
NEXT_PUBLIC_SITE_URL=https://midlineaviation.com

# Origin the live-preview iframe loads inside the admin panel — normally the
# same as the site address. Must be reachable from the browser running /admin.
NEXT_PUBLIC_SERVER_URL=https://midlineaviation.com


# ── Database ─────────────────────────────────────────────────────── REQUIRED
# cPanel / VPS: a plain file on disk. Point it OUTSIDE the deploy directory so
# a redeploy cannot wipe it. `~` is not expanded — use an absolute path.
DATABASE_URI=file:/home/<cpanel-user>/midline-data/cms.db
#
# Vercel or any serverless host: a file cannot work (read-only, ephemeral, one
# filesystem per invocation). Use hosted Turso instead:
#   DATABASE_URI=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>
DATABASE_AUTH_TOKEN=


# ── Payload ──────────────────────────────────────────────────────── REQUIRED
# Signs auth tokens and salts passwords. Changing it invalidates every existing
# login session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Shared secret for the /preview route. Defence in depth only — the real gate
# is a valid Payload session, because this value travels in the admin's iframe
# URL. Generate the same way.
PREVIEW_SECRET=


# ── File storage ─────────────────────────────────────────────────── OPTIONAL
# Leave R2_BUCKET blank to store uploads on local disk — the right choice on
# cPanel or a VPS, where you have a real filesystem and it costs nothing.
# Uploads then live in ./media and ./videos.
#
# Set these only for a serverless host, where the filesystem is read-only and
# uploads would otherwise vanish on every deploy.
R2_BUCKET=
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain for the bucket, no trailing slash. Whatever is set here
# is added to next.config.ts images.remotePatterns — without it every
# next/image request for a remote file returns 400.
NEXT_PUBLIC_MEDIA_URL=


# ── Email: booking + contact forms ──────────────────── REQUIRED for the forms
# Used by /api/booking and /api/inquiry. If HOST, USER, PASS or FROM is missing,
# both forms return "Email service is not configured yet" — the pages still
# render, the submissions just fail.
#
# Gmail needs an App Password; a normal account password is rejected:
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (the default when unset). 465 = implicit TLS; the code
# switches automatically based on this value.
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Midline Aviation <your-sender@example.com>"


# ── Chat widget ──────────────────────────────────────────────────── OPTIONAL
# Groq API key for the floating assistant (/api/chat). Leave blank and the
# widget degrades gracefully rather than erroring.
GROQ_API_KEY=


# ── Search Console ───────────────────────────────────────────────── OPTIONAL
# The token from Google Search Console's HTML-tag verification method — just
# the token, not the whole <meta> tag. Omit until you verify the domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
