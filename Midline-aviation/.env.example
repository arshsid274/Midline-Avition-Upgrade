SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Midline Aviation <your-sender-email@gmail.com>"

# ── Payload CMS ───────────────────────────────────────────────────────────────
# SQLite lives outside public/. On a VPS point this somewhere releases cannot
# clobber, e.g. file:/var/lib/midline/cms.db
DATABASE_URI=file:./data/midline.db
# Long random string — signs auth tokens and salts passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Cloudflare R2 (S3-compatible API) ────────────────────────────────────────
R2_BUCKET=midline-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain for the bucket. Must be allow-listed in next.config.ts
# images.remotePatterns — leave blank to serve uploads through Payload locally.
NEXT_PUBLIC_MEDIA_URL=
