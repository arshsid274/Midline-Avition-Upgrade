SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Midline Aviation <your-sender-email@gmail.com>"

# ── Payload CMS ───────────────────────────────────────────────────────────────
# SQLite lives outside public/. On a VPS point this somewhere releases cannot
# clobber, e.g. file:/var/lib/midline/cms.db
# Local / VPS / cPanel: a file on disk.
#   DATABASE_URI=file:./data/midline.db
# Vercel (or any serverless host): hosted Turso — a file cannot work there,
# the filesystem is read-only and per-invocation.
#   DATABASE_URI=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>
DATABASE_URI=file:./data/midline.db
DATABASE_AUTH_TOKEN=
# Long random string — signs auth tokens and salts passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Cloudflare R2 (S3-compatible API) ────────────────────────────────────────
R2_BUCKET=midline-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain for the bucket. Must be allow-listed in next.config.ts
# images.remotePatterns — leave blank to serve uploads through Payload locally.
NEXT_PUBLIC_MEDIA_URL=

# ── Live preview ─────────────────────────────────────────────────────────────
# Shared secret for the /preview route. Defence in depth — the real gate is a
# valid Payload session, since this value travels in the admin's iframe URL.
PREVIEW_SECRET=
# Origin the preview iframe loads. Must match the deployed site.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
